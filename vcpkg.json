{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "rf-tools",
  "version-string": "0.1.0",
  "description": "Tools for the RF captures of LaserDiscs",
  "builtin-baseline": "e5a1490e1409d175932ef6014519e9ae149ddb7c",
  "dependencies": [],
  "features": {
    "qt": {
      "description": "Build Qt 6 with vcpkg instead of using an installed Qt (used by build.bat; CI installs an official Qt)",
      "dependencies": [
        {
          "name": "qtbase",
          "default-features": false,
          "features": [
            "doubleconversion",
            "pcre2",
            "thread"
          ]
        }
      ]
    }
  }
}
