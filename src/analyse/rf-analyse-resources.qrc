<RCC>
    <!-- The icons of ld-analyse and ld-stacker-gui, drawn from their SVG (kept beside, in Graphics/) at 22 px and
         two and three times that for the screens with more dots; PNG, so that Qt SVG is not needed. -->
    <qresource prefix="/icons">
        <file>Graphics/256-rf-analyse.png</file>
        <file>Graphics/start-frame.png</file>
        <file>Graphics/start-frame@2x.png</file>
        <file>Graphics/start-frame@3x.png</file>
        <file>Graphics/prev-frame.png</file>
        <file>Graphics/prev-frame@2x.png</file>
        <file>Graphics/prev-frame@3x.png</file>
        <file>Graphics/next-frame.png</file>
        <file>Graphics/next-frame@2x.png</file>
        <file>Graphics/next-frame@3x.png</file>
        <file>Graphics/end-frame.png</file>
        <file>Graphics/end-frame@2x.png</file>
        <file>Graphics/end-frame@3x.png</file>
        <file>Graphics/zoom-in.png</file>
        <file>Graphics/zoom-in@2x.png</file>
        <file>Graphics/zoom-in@3x.png</file>
        <file>Graphics/zoom-out.png</file>
        <file>Graphics/zoom-out@2x.png</file>
        <file>Graphics/zoom-out@3x.png</file>
        <file>Graphics/zoom-original.png</file>
        <file>Graphics/zoom-original@2x.png</file>
        <file>Graphics/zoom-original@3x.png</file>
    </qresource>
</RCC>
